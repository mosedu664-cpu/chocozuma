<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cz_pos_cancel_reason_wizard" model="ir.ui.view">
        <field name="name">cz.pos.cancel.reason.wizard.form</field>
        <field name="model">cz.pos.cancel.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="İptal Sebebi">
                <group>
                    <field name="order_ids" widget="many2many_tags" readonly="1"/>
                    <field name="reason_code" required="1"/>
                    <field name="note" required="reason_code == 'OTHER'"/>
                </group>
                <footer>
                    <button string="İptal Et" name="action_confirm" type="object" class="btn-primary"/>
                    <button string="Vazgeç" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
