<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_cz_cash_daily" model="ir.cron">
        <field name="name">Cash Control: daily refresh, reminders and safe alerts</field>
        <field name="model_id" ref="model_cz_cash_day"/>
        <field name="state">code</field>
        <field name="code">model._cron_daily()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=6, minute=30, second=0)"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
