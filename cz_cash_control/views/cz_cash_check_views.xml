<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cz_cash_check_list" model="ir.ui.view">
        <field name="name">cz.cash.check.list</field>
        <field name="model">cz.cash.check</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-danger="difference &lt; 0" decoration-warning="difference &gt; 0" decoration-success="difference == 0">
                <field name="check_time"/>
                <field name="name"/>
                <field name="config_id" optional="hide"/>
                <field name="check_type" widget="badge"/>
                <field name="cashier_name"/>
                <field name="manager_id"/>
                <field name="opening" optional="hide"/>
                <field name="cash_sales" optional="hide"/>
                <field name="cash_moves" optional="hide"/>
                <field name="expected"/>
                <field name="counted"/>
                <field name="difference" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_cz_cash_check_form" model="ir.ui.view">
        <field name="name">cz.cash.check.form</field>
        <field name="model">cz.cash.check</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="check_time"/>
                            <field name="check_type"/>
                            <field name="cashier_name"/>
                            <field name="manager_id"/>
                            <field name="session_id"/>
                            <field name="day_id"/>
                        </group>
                        <group>
                            <field name="opening"/>
                            <field name="cash_sales"/>
                            <field name="cash_moves"/>
                            <field name="expected" class="fw-bold"/>
                            <field name="counted" class="fw-bold"/>
                            <field name="difference" class="fw-bold" decoration-danger="difference != 0"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cz_cash_check_search" model="ir.ui.view">
        <field name="name">cz.cash.check.search</field>
        <field name="model">cz.cash.check</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="cashier_name"/>
                <field name="manager_id"/>
                <filter name="with_diff" string="With difference" domain="[('difference', '!=', 0)]"/>
                <filter name="handover" string="Shift handover" domain="[('check_type', '=', 'handover')]"/>
                <filter name="spot" string="Spot check" domain="[('check_type', '=', 'spot')]"/>
                <separator/>
                <filter name="this_month" string="This month" date="check_time" default_period="month"/>
                <group expand="0" string="Group By">
                    <filter name="group_cashier" string="Cashier" context="{'group_by': 'cashier_name'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'check_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cz_cash_check" model="ir.actions.act_window">
        <field name="name">Drawer Checks</field>
        <field name="res_model">cz.cash.check</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No drawer check yet</p>
            <p>Checks are recorded from the POS with the "Sayım" button (manager PIN), without closing the register.</p>
        </field>
    </record>
</odoo>
