<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cz_cash_safe_move_list" model="ir.ui.view">
        <field name="name">cz.cash.safe.move.list</field>
        <field name="model">cz.cash.safe.move</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-warning="state == 'draft'">
                <field name="date"/>
                <field name="name"/>
                <field name="safe_id"/>
                <field name="move_type"/>
                <field name="category_id"/>
                <field name="note"/>
                <field name="employee_id"/>
                <field name="partner_id" optional="hide"/>
                <field name="amount" sum="Total"/>
                <field name="count_difference" optional="hide"/>
                <field name="receipt_ref" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state == 'draft'"/>
                <field name="create_uid" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <button name="action_approve" type="object" string="Approve" icon="fa-check" invisible="state != 'draft'"
                        groups="cz_cash_control.group_cz_cash_accountant"/>
            </list>
        </field>
    </record>

    <record id="view_cz_cash_safe_move_form" model="ir.ui.view">
        <field name="name">cz.cash.safe.move.form</field>
        <field name="model">cz.cash.safe.move</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'draft'" groups="cz_cash_control.group_cz_cash_accountant"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancelled'"
                            confirm="Cancel this safe movement?" groups="cz_cash_control.group_cz_cash_accountant"/>
                    <button name="action_reset_draft" type="object" string="Reset to draft" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="safe_id" readonly="state != 'draft'"/>
                            <field name="move_type" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="count_difference" invisible="move_type != 'count' or state == 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="category_id" invisible="move_type == 'count'" required="move_type == 'out'" readonly="state != 'draft'"/>
                            <field name="employee_id" invisible="move_type == 'count'" readonly="state != 'draft'"/>
                            <field name="partner_id" invisible="move_type == 'count'" readonly="state != 'draft'"/>
                            <field name="receipt_ref" invisible="move_type == 'count'" readonly="state != 'draft'"/>
                            <field name="origin_day_id" invisible="not origin_day_id"/>
                            <field name="statement_line_id" invisible="not statement_line_id"/>
                            <field name="approved_by" invisible="state != 'approved'"/>
                            <field name="approved_at" invisible="state != 'approved'"/>
                        </group>
                    </group>
                    <field name="note" placeholder="What was this for? (required)" readonly="state != 'draft'"/>
                    <field name="attachment_ids" widget="many2many_binary" readonly="state != 'draft'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_cz_cash_safe_move_search" model="ir.ui.view">
        <field name="name">cz.cash.safe.move.search</field>
        <field name="model">cz.cash.safe.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="note"/>
                <field name="employee_id"/>
                <field name="category_id"/>
                <filter name="draft" string="To approve" domain="[('state', '=', 'draft')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter name="this_month" string="This month" date="date" default_period="month"/>
                <group expand="0" string="Group By">
                    <filter name="group_safe" string="Safe" context="{'group_by': 'safe_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'move_type'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cz_cash_safe_move" model="ir.actions.act_window">
        <field name="name">Safe Movements</field>
        <field name="res_model">cz.cash.safe.move</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="context">{'search_default_this_month': 1}</field>
    </record>
</odoo>
