<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_cz_cash" model="ir.ui.view">
        <field name="name">hr.employee.form.cz.cash.control</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='identification_group']/field[@name='pin']" position="after">
                <field name="cz_shared_login"/>
            </xpath>
        </field>
    </record>
</odoo>
