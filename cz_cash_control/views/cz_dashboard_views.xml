<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================================
         Cash Control dashboard: one tile per POS with Cash Control enabled
         ====================================================================== -->
    <record id="view_cz_dashboard_kanban" model="ir.ui.view">
        <field name="name">pos.config.cz.dashboard.kanban</field>
        <field name="model">pos.config</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard" create="0" can_open="0">
                <field name="name"/>
                <field name="currency_id"/>
                <field name="cz_safe_id"/>
                <field name="cz_today_state"/>
                <field name="cz_today_cash_sales"/>
                <field name="cz_today_expenses"/>
                <field name="cz_today_safe_transfers"/>
                <field name="cz_safe_balance"/>
                <field name="cz_pending_count"/>
                <field name="cz_pending_amount"/>
                <field name="cz_alert_count"/>
                <field name="cz_alert_level"/>
                <field name="cz_month_expenses"/>
                <field name="cz_last_difference"/>
                <templates>
                    <t t-name="card">
                        <div class="p-2">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <strong class="fs-4"><field name="name"/></strong>
                                    <div class="text-muted small">
                                        <i class="fa fa-archive me-1"/><field name="cz_safe_id"/>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span t-if="record.cz_today_state.raw_value == 'open'" class="badge text-bg-success">
                                        <i class="fa fa-circle me-1"/>Open
                                    </span>
                                    <span t-elif="record.cz_today_state.raw_value == 'to_approve'" class="badge text-bg-warning">To approve</span>
                                    <span t-elif="record.cz_today_state.raw_value == 'approved'" class="badge text-bg-secondary">Approved</span>
                                    <span t-else="" class="badge text-bg-light">No session</span>
                                    <div t-if="record.cz_alert_count.raw_value" class="mt-1">
                                        <span t-attf-class="badge text-bg-#{record.cz_alert_level.raw_value == 'danger' ? 'danger' : 'warning'}">
                                            <i class="fa fa-exclamation-triangle me-1"/><field name="cz_alert_count"/> alert(s)
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-2 mt-2">
                                <div class="col-6">
                                    <div class="border rounded p-2 h-100">
                                        <div class="text-muted small text-uppercase">Today · cash sales</div>
                                        <div class="fs-4 fw-bold text-success"><field name="cz_today_cash_sales" widget="monetary"/></div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 h-100">
                                        <div class="text-muted small text-uppercase">Today · drawer expenses</div>
                                        <div class="fs-4 fw-bold text-danger"><field name="cz_today_expenses" widget="monetary"/></div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 h-100">
                                        <div class="text-muted small text-uppercase">Today · to safe</div>
                                        <div class="fs-5 fw-bold"><field name="cz_today_safe_transfers" widget="monetary"/></div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 h-100">
                                        <div class="text-muted small text-uppercase">Safe balance</div>
                                        <div class="fs-5 fw-bold text-primary"><field name="cz_safe_balance" widget="monetary"/></div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between text-muted small mt-2">
                                <span>Last closing difference: <strong><field name="cz_last_difference" widget="monetary"/></strong></span>
                                <span>30 days expenses: <strong><field name="cz_month_expenses" widget="monetary"/></strong></span>
                            </div>
                            <div t-if="record.cz_pending_count.raw_value" class="small mt-1">
                                <i class="fa fa-hourglass-half me-1 text-warning"/>
                                <field name="cz_pending_count"/> sheet(s) waiting for approval
                                (<field name="cz_pending_amount" widget="monetary"/> of expenses not posted yet)
                            </div>

                            <div class="mt-3 d-flex flex-wrap gap-2">
                                <button type="object" name="action_cz_open_today" class="btn btn-sm btn-primary">
                                    <i class="fa fa-file-text-o me-1"/>Today's sheet
                                </button>
                                <button type="object" name="action_cz_open_days" class="btn btn-sm btn-secondary">
                                    <i class="fa fa-check-square-o me-1"/>To approve
                                </button>
                                <button type="object" name="action_cz_open_graph" class="btn btn-sm btn-secondary">
                                    <i class="fa fa-bar-chart me-1"/>30-day graph
                                </button>
                                <button t-if="record.cz_safe_id.raw_value" type="object" name="action_cz_open_safe" class="btn btn-sm btn-link">
                                    <i class="fa fa-archive me-1"/>Safe
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_cz_dashboard" model="ir.actions.act_window">
        <field name="name">Cash Control Dashboard</field>
        <field name="res_model">pos.config</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_cz_dashboard_kanban"/>
        <field name="domain">[('cz_cash_control', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No POS with Cash Control yet</p>
            <p>Enable "Choco Zuma Cash Control" in the POS settings to see it here.</p>
        </field>
    </record>

    <!-- ======================================================================
         30-day expenses by category (graph)
         ====================================================================== -->
    <record id="view_cz_cash_day_line_search" model="ir.ui.view">
        <field name="name">cz.cash.day.line.search</field>
        <field name="model">cz.cash.day.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="category_id"/>
                <field name="config_id"/>
                <filter name="last30" string="Last 30 days"
                        domain="[('date', '>=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter name="this_month" string="This month" date="date" default_period="month"/>
                <separator/>
                <filter name="expenses_only" string="Expenses only" domain="[('kind', 'in', ('expense', 'advance', 'salary', 'other'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_pos" string="Point of Sale" context="{'group_by': 'config_id'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_cz_cash_day_line_graph" model="ir.ui.view">
        <field name="name">cz.cash.day.line.graph</field>
        <field name="model">cz.cash.day.line</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="1" string="Drawer expenses by category">
                <field name="date" interval="day"/>
                <field name="category_id"/>
                <field name="spent" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_cz_cash_day_line_graph" model="ir.actions.act_window">
        <field name="name">Expenses by Category — 30 days</field>
        <field name="res_model">cz.cash.day.line</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="view_id" ref="view_cz_cash_day_line_graph"/>
        <field name="search_view_id" ref="view_cz_cash_day_line_search"/>
        <field name="context">{'search_default_last30': 1, 'search_default_expenses_only': 1}</field>
    </record>

    <!-- the existing category report gets the same search view -->
    <record id="action_cz_cash_day_line" model="ir.actions.act_window">
        <field name="search_view_id" ref="view_cz_cash_day_line_search"/>
    </record>

    <!-- ======================================================================
         Monthly report per staff member (taxi, food, advances...)
         ====================================================================== -->
    <record id="view_cz_staff_expense_pivot" model="ir.ui.view">
        <field name="name">account.bank.statement.line.cz.staff.pivot</field>
        <field name="model">account.bank.statement.line</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <pivot string="Staff expenses" disable_linking="1">
                <field name="cz_employee_id" type="row"/>
                <field name="cz_category_id" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_cz_staff_expense_list" model="ir.ui.view">
        <field name="name">account.bank.statement.line.cz.staff.list</field>
        <field name="model">account.bank.statement.line</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0" default_order="date desc">
                <field name="date"/>
                <field name="cz_employee_id"/>
                <field name="cz_category_id"/>
                <field name="payment_ref"/>
                <field name="cz_receipt_ref" optional="show"/>
                <field name="cz_has_receipt_image" string="Photo" widget="boolean" optional="show"/>
                <field name="cz_pos_cashier" optional="hide"/>
                <field name="journal_id" optional="hide"/>
                <field name="amount" sum="Total"/>
                <field name="cz_approved" optional="show"/>
                <field name="company_id" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_cz_staff_expense_graph" model="ir.ui.view">
        <field name="name">account.bank.statement.line.cz.staff.graph</field>
        <field name="model">account.bank.statement.line</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="1" string="Staff expenses">
                <field name="cz_employee_id"/>
                <field name="cz_category_id"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_cz_staff_expense_search" model="ir.ui.view">
        <field name="name">account.bank.statement.line.cz.staff.search</field>
        <field name="model">account.bank.statement.line</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search>
                <field name="cz_employee_id"/>
                <field name="cz_category_id"/>
                <field name="payment_ref"/>
                <filter name="this_month" string="This month" date="date" default_period="month"/>
                <filter name="last30" string="Last 30 days"
                        domain="[('date', '>=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="with_staff" string="With staff member" domain="[('cz_employee_id', '!=', False)]"/>
                <filter name="no_receipt" string="Without receipt / photo"
                        domain="[('cz_receipt_ref', '=', False), ('cz_receipt_image', '=', False)]"/>
                <filter name="approved" string="Approved" domain="[('cz_approved', '=', True)]"/>
                <filter name="not_approved" string="Not approved yet" domain="[('cz_approved', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_employee" string="Staff" context="{'group_by': 'cz_employee_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'cz_category_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                    <filter name="group_journal" string="Journal" context="{'group_by': 'journal_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cz_staff_expenses" model="ir.actions.act_window">
        <field name="name">Staff Expenses (taxi, food, advances)</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_cz_staff_expense_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_cz_staff_expense_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_cz_staff_expense_graph')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_cz_staff_expense_list')})]"/>
        <field name="domain">[('cz_category_id', '!=', False), ('cz_end_of_day', '=', False)]</field>
        <field name="context">{'search_default_this_month': 1, 'search_default_with_staff': 1, 'search_default_group_employee': 1, 'create': 0}</field>
    </record>
</odoo>
