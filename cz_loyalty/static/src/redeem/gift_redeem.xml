<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Kakao Hazinesi: "İkram Kodu" in the Actions dialog of the product screen. -->
    <t t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons-modal')]/OrderlineNoteButton[last()]" position="after">
            <button t-if="pos.config.cz_loyalty_redeem" class="btn btn-secondary btn-lg py-5" t-on-click="() => this.czClickGiftCode()">
                <i class="fa fa-gift me-1" role="img" aria-label="İkram Kodu" title="İkram Kodu"/>
                İkram Kodu
            </button>
        </xpath>
    </t>
</templates>
