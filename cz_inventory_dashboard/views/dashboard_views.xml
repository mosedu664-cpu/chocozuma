<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_cz_inventory_dashboard" model="ir.actions.client">
        <field name="name">Sevkiyat Paneli</field>
        <field name="tag">cz_inventory_dashboard</field>
    </record>

    <!-- First entry under Inventory, visible to every inventory user -->
    <menuitem id="menu_cz_inventory_dashboard"
              name="Sevkiyat Paneli"
              parent="stock.menu_stock_root"
              action="action_cz_inventory_dashboard"
              sequence="0"
              groups="stock.group_stock_user"/>

    <!-- Inventory opens on the board: the app's root menu points straight at it,
         and the standard "Overview" moves to second place (restored by the uninstall hook). -->
    <record id="stock.menu_stock_root" model="ir.ui.menu">
        <field name="action" ref="action_cz_inventory_dashboard"/>
    </record>
    <record id="stock.stock_picking_type_menu" model="ir.ui.menu">
        <field name="sequence">1</field>
    </record>
</odoo>
