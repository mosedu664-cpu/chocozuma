<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        Registering the webhook makes Meta verify the callback URL within seconds, and Meta
        gives up after 6. Doing it from the HTTP request that finishes the onboarding would
        block a worker waiting for the service while Meta knocks on the door, and on a small
        instance the verification queues behind it and times out. The cron thread does it
        instead, so every HTTP worker stays free to answer.
    -->
    <record id="cron_wacoex_subscribe" model="ir.cron">
        <field name="name">WhatsApp Coexistence: register pending webhooks</field>
        <field name="model_id" ref="whatsapp.model_whatsapp_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_wacoex_subscribe()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
