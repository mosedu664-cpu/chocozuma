#. odoo-python
#: code:addons/whatsapp_coexistence/models/whatsapp_account.py:0
msgid "There is no connection session in progress. Click Connect again."
msgstr ""
"Não há nenhuma sessão de conexão em andamento. Clique novamente em Conectar."

#. module: whatsapp_coexistence
#. odoo-python
#: code:addons/whatsapp_coexistence/models/whatsapp_account.py:0
msgid ""
"This number was NOT linked to the WhatsApp Business app "
"(is_on_biz_app=%(on)s, platform_type=%(platform)s, status=%(status)s). Check"
" that the Embedded Signup uses the coexistence Login Configuration and "
"connect again; the syncs will fail with \"Account not registered\"."
msgstr ""
"Este número NÃO ficou vinculado ao app WhatsApp Business "
"(is_on_biz_app=%(on)s, platform_type=%(platform)s, status=%(status)s). "
"Verifique se o Embedded Signup usa a Login Configuration de coexistence e "
"conecte novamente; as sincronizações vão falhar com \"Account not "
"registered\"."

#. module: whatsapp_coexistence
